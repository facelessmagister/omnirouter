{
  "name": "omnirouter",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:contract": "node scripts/check-contract.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:contract && pnpm check:rules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
