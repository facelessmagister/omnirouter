      "checkConstraints": {
        "slug_format": {
          "name": "slug_format",
          "value": "\"mcp_servers\".\"slug\" ~ '^[a-z0-9][a-z0-9-]{1,126}[a-z0-9]$'"
        },
        "remote_requires_endpoint": {
          "name": "remote_requires_endpoint",
          "value": "(\"mcp_servers\".\"transport_type\" = 'stdio') = (\"mcp_servers\".\"endpoint_url\" IS NULL)"
        },
        "stdio_requires_package": {
          "name": "stdio_requires_package",
          "value": "\"mcp_servers\".\"transport_type\" <> 'stdio' OR \"mcp_servers\".\"package_identifier\" IS NOT NULL"
        },
        "endpoint_https": {
          "name": "endpoint_https",
          "value": "\"mcp_servers\".\"endpoint_url\" IS NULL OR \"mcp_servers\".\"endpoint_url\" LIKE 'https://%'"
        },
        "auth_mode_matches_json": {
          "name": "auth_mode_matches_json",
          "value": "\"mcp_servers\".\"auth_mode\"::text = \"mcp_servers\".\"auth_requirements\"->>'mode'"
        },
        "monetization_matches_json": {
          "name": "monetization_matches_json",
          "value": "\"mcp_servers\".\"monetization_model\"::text = \"mcp_servers\".\"monetization\"->>'model'"
        },
        "active_has_embedding": {
          "name": "active_has_embedding",
          "value": "\"mcp_servers\".\"status\" NOT IN ('active','degraded') OR (\"mcp_servers\".\"embedding\" IS NOT NULL AND \"mcp_servers\".\"mcp_definition\" IS NOT NULL)"
        },
        "trust_range": {
          "name": "trust_range",
          "value": "\"mcp_servers\".\"trust_score\" BETWEEN 0 AND 100"
        },
        "active_not_broken": {
          "name": "active_not_broken",
          "value": "\"mcp_servers\".\"status\" NOT IN ('active','degraded') OR \"mcp_servers\".\"verification_class\" IS DISTINCT FROM 'broken'"
        }
      },
      "isRLSEnabled": false
    },
